<Project>

  <!--
    Single source of truth for the Concordex spec version this SDK targets.
    Per sdk-spec.md §11.1, the CI workflow checks this against the spec
    repo's VERSION tag and fails loud on drift.
  -->
  <PropertyGroup>
    <ConcordexSpecVersion>0.5.0</ConcordexSpecVersion>
    <Version>$(ConcordexSpecVersion)</Version>
    <PackageVersion>$(ConcordexSpecVersion)</PackageVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Source-link / repro builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
